generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  employee
  org_admin
  platform_admin
}

enum EmployeeStatus {
  Active
  OnLeave
  Inactive
  Resigned
  Terminated
}

model Company {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  domain              String?
  country             String               @default("India")
  timezone            String               @default("Asia/Kolkata")
  logoUrl             String?
  hrContactEmail      String?
  isActive            Boolean              @default(true)
  accessRoles         AccessRole[]
  accessLevels        AccessLevel[]
  users               User[]
  passwordResetTokens PasswordResetToken[]
  securityAuditLogs   SecurityAuditLog[]
  employees           Employee[]
  profiles            EmployeeProfile[]
  documents           EmployeeDocument[]
  auditLogs           AuditLog[]
  legalEntities       LegalEntity[]
  businessUnits       BusinessUnit[]
  departments         Department[]
  teams               Team[]
  locations           Location[]
  costCenters         CostCenter[]
  approvalRequests    ApprovalRequest[]
  jobFamilies         JobFamily[]
  gradeBands          GradeBand[]
  jobTitles           JobTitle[]
  payComponents       PayComponent[]
  employmentTypes     EmploymentType[]
  workModes           WorkMode[]
  workShifts          WorkShift[]
  holidayCalendars    HolidayCalendar[]
  workflowDefinitions FlowDefinition[]
  workflowInstances   FlowInstance[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])
  email               String
  authVersion         Int                  @default(0)
  accessRoles         AccessUserRole[]
  passwordHash        String
  role                UserRole             @default(employee)
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  employeeCode        String?
  employee            Employee?            @relation(fields: [companyId, employeeCode], references: [companyId, code])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  securityAuditLogs   SecurityAuditLog[]

  @@unique([companyId, id])
  @@unique([companyId, email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

model Employee {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  code         String
  name         String
  email        String
  phone        String?
  role         String
  department   String
  entity       String
  location     String
  manager      String
  status       EmployeeStatus     @default(Active)
  type         String
  grade        String
  joinDate     DateTime
  documentNote String             @default("No recent uploads")
  profile      EmployeeProfile?
  documents    EmployeeDocument[]
  users        User[]
  auditLogs    AuditLog[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, email])
}

model EmployeeProfile {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  employeeCode       String    @unique
  employee           Employee  @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  dateOfBirth        DateTime?
  gender             String?
  maritalStatus      String?
  bloodGroup         String?
  nationality        String?
  emergencyContact   String?
  emergencyPhone     String?
  workMode           String?
  noticePeriod       String?
  shift              String?
  businessUnit       String?
  team               String?
  costCenter         String?
  hrPartner          String?
  currentAddress     String?
  permanentAddress   String?
  previousEmployment Json?
  education          Json?
  bankDetails        Json?
  statutoryDetails   Json?
  salaryDetails      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, employeeCode])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeCode String
  employee     Employee @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  type         String
  status       String
  note         String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeCode String
  employee     Employee @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())
}

model Industry {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([category])
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  code3     String?
  phoneCode String?
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([region])
}

model Currency {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  symbol        String
  decimalDigits Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([name])
}

model TimeZone {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String
  offset    String
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([region])
}

model LegalEntity {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  taxId         String?
  country       String?
  address       String?
  isActive      Boolean        @default(true)
  businessUnits BusinessUnit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model BusinessUnit {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  description   String?
  isActive      Boolean      @default(true)
  departments   Department[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Department {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  name           String
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  description    String?
  isActive       Boolean       @default(true)
  teams          Team[]
  costCenters    CostCenter[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Team {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model CostCenter {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeCode  String
  employeeName  String
  department    String
  role          String
  category      String
  status        String    @default("Pending")
  changes       Json
  notes         String?
  rejectionNote String?
  actionDate    DateTime?
  submittedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([employeeCode])
  @@index([status])
}

model JobFamily {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  stream      String     @default("Individual Contributor")
  description String?
  isActive    Boolean    @default(true)
  jobTitles   JobTitle[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model GradeBand {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  levelRank   Int        @default(1)
  minSalary   Float      @default(0)
  maxSalary   Float      @default(0)
  currency    String     @default("INR")
  description String?
  isActive    Boolean    @default(true)
  jobTitles   JobTitle[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model JobTitle {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  jobFamilyId String?
  jobFamily   JobFamily? @relation(fields: [jobFamilyId], references: [id], onDelete: SetNull)
  gradeBandId String?
  gradeBand   GradeBand? @relation(fields: [gradeBandId], references: [id], onDelete: SetNull)
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model PayComponent {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            String   @default("Earning")
  calculationType String   @default("Fixed Amount")
  value           Float    @default(0)
  isTaxable       Boolean  @default(true)
  isStatutory     Boolean  @default(false)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model EmploymentType {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code             String
  name             String
  category         String   @default("Permanent")
  noticePeriodDays Int      @default(30)
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model WorkMode {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  allowedRemoteDays  Int      @default(0)
  requiresGeofencing Boolean  @default(false)
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model WorkShift {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  startTime          String   @default("09:00")
  endTime            String   @default("18:00")
  gracePeriodMinutes Int      @default(15)
  halfDayHours       Float    @default(4.0)
  breakDurationMins  Int      @default(60)
  isFlexible         Boolean  @default(false)
  isRotational       Boolean  @default(false)
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model HolidayCalendar {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  date               DateTime
  type               String   @default("Mandatory")
  applicableLocation String   @default("All Locations")
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name, date])
  @@index([companyId])
}

// Generic workflow platform. Published documents are immutable snapshots.
model FlowDefinition {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String         @default("")
  category    String         @default("General")
  status      String         @default("DRAFT")
  revision    Int            @default(1)
  draft       Json
  createdBy   String
  versions    FlowVersion[]
  instances   FlowInstance[]
  bindings    FlowBinding[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId, status])
}

model FlowVersion {
  id           String         @id @default(cuid())
  definitionId String
  definition   FlowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  number       Int
  document     Json
  publishedBy  String
  createdAt    DateTime       @default(now())
  instances    FlowInstance[]

  @@unique([definitionId, number])
}

model FlowInstance {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definitionId String
  definition   FlowDefinition @relation(fields: [definitionId], references: [id])
  versionId    String
  version      FlowVersion    @relation(fields: [versionId], references: [id])
  requesterId  String
  title        String
  status       String         @default("RUNNING")
  state        String
  data         Json
  revision     Int            @default(1)
  source       String?
  entityId     String?
  test         Boolean        @default(false)
  pausedAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tokens       FlowToken[]
  tasks        FlowTask[]
  events       FlowEvent[]

  @@index([companyId, status, createdAt])
  @@index([companyId, source, entityId])
}

model FlowToken {
  id         String       @id @default(cuid())
  instanceId String
  instance   FlowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  nodeId     String
  status     String       @default("READY")
  groupId    String?
  branch     String?
  scope      Json         @default("[]")
  attempts   Int          @default(0)
  error      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([instanceId, status])
}

model FlowTask {
  id          String       @id @default(cuid())
  companyId   String
  instanceId  String
  instance    FlowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tokenId     String       @unique
  nodeId      String
  title       String
  status      String       @default("OPEN")
  candidates  Json
  claimedBy   String?
  votes       Json         @default("[]")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, status, dueAt])
}

model FlowJob {
  id          String    @id @default(cuid())
  companyId   String
  instanceId  String?
  kind        String
  key         String    @unique
  payload     Json
  status      String    @default("PENDING")
  dueAt       DateTime  @default(now())
  leaseUntil  DateTime?
  lockedBy    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueAt, leaseUntil])
}

model FlowEvent {
  id         String        @id @default(cuid())
  companyId  String
  instanceId String?
  instance   FlowInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actorId    String?
  type       String
  nodeId     String?
  detail     Json
  createdAt  DateTime      @default(now())

  @@index([companyId, instanceId, createdAt])
}

model FlowReceipt {
  id         String   @id @default(cuid())
  companyId  String
  key        String
  instanceId String?
  createdAt  DateTime @default(now())

  @@unique([companyId, key])
}

model FlowBinding {
  id           String         @id @default(cuid())
  companyId    String
  source       String
  definitionId String
  definition   FlowDefinition @relation(fields: [definitionId], references: [id])
  outcomes     Json
  createdAt    DateTime       @default(now())

  @@unique([companyId, source])
}

model FlowRecord {
  id        String   @id @default(cuid())
  companyId String
  type      String
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, type])
}

model FlowMembership {
  id          String @id @default(cuid())
  companyId   String
  userId      String
  kind        String
  referenceId String

  @@unique([companyId, userId, kind, referenceId])
}

model FlowAttachment {
  id         String   @id @default(cuid())
  companyId  String
  instanceId String
  uploadedBy String
  name       String
  mime       String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([companyId, instanceId])
}

model FlowConnection {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  baseUrl         String
  encryptedSecret String
  createdAt       DateTime @default(now())

  @@index([companyId])
}

model FlowHeartbeat {
  id       String   @id
  lastSeen DateTime @updatedAt
}

model AccessLevel {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      Int
  displayName String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       AccessRole[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, isActive])
}

model AccessRole {
  id             String @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String @default("")
  levelId        String
  level          AccessLevel @relation(fields: [companyId, levelId], references: [companyId, id], onDelete: Restrict)
  permissionKeys String[] @default([])
  isActive       Boolean @default(true)
  revision       Int @default(1)
  users          AccessUserRole[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@index([companyId, isActive])
}
model AccessUserRole {
  companyId String
  userId    String
  roleId    String
  user      User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)
  role      AccessRole @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([companyId, roleId])
}
