generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  employee
  org_admin
  platform_admin
}

enum EmployeeStatus {
  Active
  OnLeave
  Inactive
  Resigned
  Terminated
}

model Company {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  domain         String?
  country        String             @default("India")
  timezone       String             @default("Asia/Kolkata")
  logoUrl        String?
  hrContactEmail String?
  isActive       Boolean            @default(true)
  users          User[]
  passwordResetTokens PasswordResetToken[]
  securityAuditLogs SecurityAuditLog[]
  employees      Employee[]
  profiles       EmployeeProfile[]
  documents      EmployeeDocument[]
  auditLogs      AuditLog[]
  legalEntities  LegalEntity[]
  businessUnits  BusinessUnit[]
  departments    Department[]
  teams          Team[]
  locations      Location[]
  costCenters    CostCenter[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}


model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String
  passwordHash String
  role         UserRole  @default(employee)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  passwordChangedAt DateTime?
  employeeCode String?
  employee     Employee? @relation(fields: [companyId, employeeCode], references: [companyId, code])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
  securityAuditLogs SecurityAuditLog[]

  @@unique([companyId, email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

model Employee {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  code             String
  name             String
  email            String
  phone            String?
  role             String
  department       String
  entity           String
  location         String
  manager          String
  status           EmployeeStatus     @default(Active)
  type             String
  grade            String
  joinDate         DateTime
  documentNote     String             @default("No recent uploads")
  profile          EmployeeProfile?
  documents        EmployeeDocument[]
  users            User[]
  auditLogs        AuditLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, email])
}

model EmployeeProfile {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  employeeCode        String   @unique
  employee            Employee @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  dateOfBirth         DateTime?
  gender              String?
  maritalStatus       String?
  bloodGroup          String?
  nationality         String?
  emergencyContact    String?
  emergencyPhone      String?
  workMode            String?
  noticePeriod        String?
  shift               String?
  businessUnit        String?
  team                String?
  costCenter          String?
  hrPartner           String?
  currentAddress      String?
  permanentAddress    String?
  previousEmployment  Json?
  education           Json?
  bankDetails         Json?
  statutoryDetails    Json?
  salaryDetails       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, employeeCode])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeCode String
  employee     Employee @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  type         String
  status       String
  note         String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  employeeCode String
  employee     Employee @relation(fields: [companyId, employeeCode], references: [companyId, code], onDelete: Cascade)
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())
}

model Industry {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([category])
}

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  code3       String?
  phoneCode   String?
  region      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([region])
}

model Currency {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  symbol        String
  decimalDigits Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([name])
}

model TimeZone {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String
  offset    String
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([region])
}

model LegalEntity {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  taxId         String?
  country       String?
  address       String?
  isActive      Boolean        @default(true)
  businessUnits BusinessUnit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model BusinessUnit {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  description   String?
  isActive      Boolean      @default(true)
  departments   Department[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Department {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  name           String
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  description    String?
  isActive       Boolean       @default(true)
  teams          Team[]
  costCenters    CostCenter[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Team {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}

model CostCenter {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
}


