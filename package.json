{
  "name": "hrms-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3006",
    "dev:backend": "npm --prefix backend run start:dev",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run prisma:seed",
    "build": "next build",
    "start": "next start",
    "dev:workflow-worker": "npm --prefix backend run workflow:worker:dev",
    "test:workflows:browser": "playwright test tests/workflows.spec.js",
    "test:access-control:browser": "playwright test tests/access-control.spec.js",
    "test:roles-users:browser": "playwright test tests/roles-users.spec.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
